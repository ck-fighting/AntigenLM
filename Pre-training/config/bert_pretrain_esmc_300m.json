{
    "name": "esmc_300m_pretrain_scratch",
    "n_gpu": 4,
    "pretrained_model_path": "",
    "dataset": {
        "type": "MAADataset",
        "args": {
            "seq_dir": "./dataset/micro_nr50_priority.fasta",
            "token_length_list": "",
            "vocab_dir": "",
            "seed": 0,
            "seq_name": "dataset_micro",
            "tokenizer_name": "esmc",
            "max_len": 256,
            "test_split": 0.001
        }
    },
    "model": {
        "bert": "esmc",
        "args": {
            "d_model": 960,
            "n_heads": 15,
            "n_layers": 30,
            "use_flash_attn": false
        }
    },
    "metrics": {
        "blosum_dir": "./bert_data_prepare/blosum62.json",
        "blosum": true
    },
    "trainer": {
        "epochs": 20,
        "batch_size": 1,
        "mlm_probability": 0.15,
        "save_dir": "../LLM_download/ESMC_300M_scratch_mlm",
        "lr": 1e-4,
        "warmup": 0.1,
        "weight_decay": 0.01,
        "eval_accumulation_steps": 64,
        "logging_steps": 100
    },
    "deepspeed": {
        "train_micro_batch_size_per_gpu": 1,
        "gradient_accumulation_steps": 64,
        "deepspeed_multinode_launcher": "standard",
        "optimizer": {
            "type": "AdamW",
            "params": {
                "lr": "auto",
                "weight_decay": "auto"
            }
        },
        "fp16": {
            "enabled": true
        },
        "zero_optimization": {
            "stage": 2,
            "overlap_comm": true,
            "stage3_gather_16bit_weights_on_model_save": true
        },
        "gradient_clipping": 1.0,
        "steps_per_print": 2000,
        "wall_clock_breakdown": true
    }
}
